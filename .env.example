# --- Réplica de SIESA (Postgres) — los mismos valores que backend_analitica ---
POSTGRES_HOST=
POSTGRES_PORT=6543
POSTGRES_DATABASE=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
POSTGRES_STATEMENT_TIMEOUT=55000

# --- Inventario en vivo (consulta estándar de SIESA) — los mismos que backend-traslado ---
CONNEKTA_BASE_URL=
CONNEKTA_ID_COMPANIA=7375
CONNI_KEY=
CONNI_TOKEN=
# Opcional: un par propio solo para la consulta de inventario.
SIESA_STOCK_CONNI_KEY=
SIESA_STOCK_CONNI_TOKEN=

# --- Sesión de la página (Supabase) — los mismos que backend_analitica ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# off | report | enforce. Vacío = report (deja pasar y registra a quién habría rechazado).
FRUVER_AUTH=report
# Orígenes del front separados por coma. Vacío = localhost:5173 y merkahorro.com.
FRUVER_ALLOWED_ORIGINS=
